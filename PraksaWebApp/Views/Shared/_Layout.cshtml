<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PraksaWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PraksaWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <style>
            body {
                background-color: #eaf6ff;
            }

            /* Стилови за новото лого во навигацијата */
            .brand-logo-container {
                display: flex;
                align-items: center;
                text-decoration: none;
            }

            .brand-logo-img {
                height: 48px;
                width: auto;
                margin-right: 12px;
            }

            .brand-text {
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .brand-title {
                color: #0d4b75;
                font-weight: 800;
                font-size: 1.35rem;
                letter-spacing: 0.5px;
                line-height: 1;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

            .brand-subtitle {
                color: #7b9bb2;
                font-weight: 600;
                font-size: 0.68rem;
                letter-spacing: 1.2px;
                margin-top: 3px;
                text-transform: uppercase;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

            /* Стилови за табелата */
            table {
                background-color: white;
                border-radius: 8px;
                overflow: hidden;
            }

                table thead {
                    background-color: #d9f0ff;
                }

                    table thead th {
                        color: #1f3f55;
                    }

                table tbody tr {
                    background-color: white;
                }

                    table tbody tr:hover {
                        background-color: #eef9ff;
                    }

                table td,
                table th {
                    border-color: #c9dce8;
                }

            /* АКТИВНА СТАВКА ВО НАВИГАЦИЈАТА */
            .navbar-nav .nav-link.active-page {
                background-color: #d6e8f5;
                color: #0d4b75 !important;
                font-weight: 600;
                border-radius: 6px;
            }

            .navbar-nav .nav-link {
                border-radius: 6px;
                margin-right: 3px;
                transition: background-color 0.2s ease;
            }

                .navbar-nav .nav-link:hover {
                    background-color: #eef7fc;
                }

                .navbar-nav .nav-link.active-page {
                    color: #343a40 !important;
                    font-weight: 500;
                }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 py-2">

            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand me-4"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <div class="brand-logo-container">

                        <div class="logo-icon-box me-2 d-flex align-items-center justify-content-center bg-primary text-white rounded-3"
                             style="width: 44px; height: 44px; background-color: #0d6efd !important;">

                            <i class="bi bi-heart-pulse-fill fs-4"></i>

                        </div>

                        <div class="brand-text">
                            <span class="brand-title">MEDICAL SYSTEM</span>
                            <span class="brand-subtitle">HEALTHCARE MANAGEMENT</span>
                        </div>

                    </div>
                </a>
                <!-- MOBILE MENU BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @{
                        var tipClaim = User.FindFirst("tip_korisnik")?.Value;
                        var tip = tipClaim != null ? int.Parse(tipClaim) : -1;

                        var currentController =
                            ViewContext.RouteData.Values["controller"]?.ToString();

                        var currentAction =
                            ViewContext.RouteData.Values["action"]?.ToString();

                        var username =
                            Context.Session.GetString("username");

                        var imePrezime =
                            Context.Session.GetString("ime_prezime");
                    }
                    <!-- NAVIGATION -->
                    <ul class="navbar-nav flex-grow-1">
                        <!-- ДОМА -->
                        @if (tip == 0)
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark @(currentController == "Home" && currentAction == "Index" ? "active-page" : "")"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Дома

                                </a>

                            </li>
                            <!-- ДОКТОРИ -->
                            <li class="nav-item">

                                <a class="nav-link text-dark @(currentController == "Doctors" ? "active-page" : "")"
                                   asp-area=""
                                   asp-controller="Doctors"
                                   asp-action="Index">

                                    Доктори

                                </a>

                            </li>
                            <!-- ПАЦИЕНТИ -->
                            <li class="nav-item">

                                <a class="nav-link text-dark @(currentController == "Patients" ? "active-page" : "")"
                                   asp-area=""
                                   asp-controller="Patients"
                                   asp-action="Index">

                                    Пациенти

                                </a>

                            </li>
                        }
                        <!-- ТЕРМИНИ -->
                        <li class="nav-item">

                            <a class="nav-link text-dark @(currentController == "Appointments" ? "active-page" : "")"
                               asp-area=""
                               asp-controller="Appointments"
                               asp-action="Index">

                                Термини

                            </a>

                        </li>

                        @if (tip == 0)
                        {
                            <!-- СТАТУС -->
                            <li class="nav-item">

                                <a class="nav-link text-dark @(currentController == "Status" ? "active-page" : "")"
                                   asp-area=""
                                   asp-controller="Status"
                                   asp-action="Index">

                                    Статус

                                </a>

                            </li>
                            <!-- ТИПОВИ НА СПЕЦИЈАЛИЗАЦИЈА -->
                            <li class="nav-item">

                                <a class="nav-link text-dark @(currentController == "Tipovi_na_specijalizacija" ? "active-page" : "")"
                                   asp-area=""
                                   asp-controller="Tipovi_na_specijalizacija"
                                   asp-action="Index">

                                    Типови на специјализација

                                </a>

                            </li>
                            <!-- КОРИСНИК -->
                            <li class="nav-item">

                                <a class="nav-link text-dark @(currentController == "Korisnik" ? "active-page" : "")"
                                   asp-area=""
                                   asp-controller="Korisnik"
                                   asp-action="Lista">

                                    Корисник

                                </a>

                            </li>
                        }

                    </ul>
                    <!-- USER INFO -->
                    @if (!string.IsNullOrEmpty(username))
                    {

                        <div class="d-flex align-items-center">

                            <div class="me-3">

                                @if (tipClaim == "0")
                                {
                                    <span>Администратор</span>
                                }
                                else if (tipClaim == "1")
                                {
                                    <span>Доктор: @imePrezime</span>
                                }
                                else if (tipClaim == "2")
                                {
                                    <span>Пациент: @imePrezime</span>
                                }

                            </div>
                            <!-- USER DROPDOWN -->
                            <div class="dropdown">

                                <button class="btn btn-light rounded-circle d-flex align-items-center justify-content-center"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        style="width: 42px; height: 42px;">

                                    <i class="bi bi-person-fill"></i>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>

                                        <span class="dropdown-item-text">
                                            @username
                                        </span>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>

                                        <form asp-controller="Korisnik"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item">

                                                <i class="bi bi-box-arrow-right me-2"></i>

                                                Одјави се

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </nav>
    </header>
    <!-- MAIN CONTENT -->
    <div class="container flex-grow-1">

        <main role="main" class="pb-4">

            @RenderBody()

        </main>

    </div>
    <!-- FOOTER -->
    <footer class="border-top footer text-muted mt-auto">

        <div class="container">

            &copy; 2026 - PraksaWebApp -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>
    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>