@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<Appointments>

<style>
    /* ЗАКАЖАН - нежно жолта */
    .status-scheduled td {
        background-color: #fff9e6 !important;
    }

    /* ЗАВРШЕН - нежно зелена */
    .status-completed td {
        background-color: #edf8f0 !important;
    }

    /* ОТКАЖАН - нежно црвена */
    .status-cancelled td {
        background-color: #fff0f0 !important;
    }

    /* ВО ТЕК - нежно лилакова */
    .status-vo-tek td {
        background-color: #f7f1fb !important;
    }

    .btn-start {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffe69c;
    }

        .btn-start:hover {
            background-color: #ffedb5;
            color: #856404;
        }

    .btn-finish {
        background-color: #dff3e4;
        color: #3c6b48;
        border: 1px solid #bfe3c8;
    }

        .btn-finish:hover {
            background-color: #d2ecd9;
            color: #3c6b48;
        }

</style>

<table class="table table-bordered table-hover">

    <thead class="table-info">
        <tr>

            <!-- АКЦИИ -->
            <th>Акции</th>

            <!-- ДАТУМ -->
            <th>
                <a href="@Url.Action("Index", new
                   {
                       sort = "date",
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo
                   })">
                    Датум
                </a>
            </th>

            <!-- ВРЕМЕ -->
            <th>
                <a href="@Url.Action("Index", new
                   {
                       sort = "time",
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo,
                       vreme_od = Context.Request.Query["vreme_od"],
                       vreme_do = Context.Request.Query["vreme_do"]
                   })">
                    Време
                </a>
            </th>

            <!-- ПАЦИЕНТ -->
            <th>
                <a href="@Url.Action("Index", new
                   {
                       sort = "patient",
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo
                   })">
                    Пациент
                </a>
            </th>

            <!-- ЛЕКАР -->
            <th>
                <a href="@Url.Action("Index", new
                   {
                       sort = "doctor",
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo
                   })">
                    Лекар
                </a>
            </th>

            <!-- СТАТУС -->
            <th>
                <a href="@Url.Action("Index", new
                   {
                       sort = "status",
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo
                   })">
                    Статус
                </a>
            </th>

            <!-- ЗАБЕЛЕШКА -->
            <th>Забелешка</th>

            <!-- AUDIT КОЛОНИ -->
            <th>Креирано на</th>
            <th>Креирано од</th>
            <th>Изменето на</th>
            <th>Изменето од</th>
            <th>Промени статус</th>
            <th>Историја</th>

        </tr>
    </thead>

    <tbody>

        @foreach (var rez in Model)
        {
            var rowClass = rez.status switch
            {
                "ЗАКАЖАН" => "status-scheduled",
                "ЗАВРШЕН" => "status-completed",
                "ОТКАЖАН" => "status-cancelled",
                "ВО ТЕК" => "status-vo-tek",
                _ => ""
            };

            <tr class="@rowClass">

                <!-- АКЦИИ -->
                <td>

                    <!-- Измени -->
                    <button class="btn btn-warning btn-sm"
                            onclick="editAppointment(
                        @(rez.id ?? 0),
                        @(rez.doctor_id ?? 0),
                        @(rez.patientid ?? 0),
                        '@rez.appointmentdate.ToString("yyyy-MM-dd")',
                        '@(rez.appointmenttime.Length >= 5
                        ? rez.appointmenttime.Substring(0, 5)
                        : rez.appointmenttime)',
                        @(rez.status_id ?? 0),
                        '@(rez.notes ?? "")'
                        )">

                        <i class="bi bi-pencil"></i>

                    </button>

                    <!-- Избриши -->
                    <form asp-controller="Appointments"
                          asp-action="Delete"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="id"
                               value="@rez.id" />

                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Дали сте сигурни?')">

                            <i class="bi bi-trash"></i>

                        </button>

                    </form>

                </td>

                <!-- ДАТУМ -->
                <td>
                    @rez.appointmentdate.ToString("dd.MM.yyyy")
                </td>

                <!-- ВРЕМЕ -->
                <td>
                    @(rez.appointmenttime.Length >= 5
                        ? rez.appointmenttime.Substring(0, 5)
                        : rez.appointmenttime)
                </td>

                <!-- ПАЦИЕНТ -->
                <td>
                    @rez.patient_first_name @rez.patient_last_name
                </td>

                <!-- ЛЕКАР -->
                <td>
                    @rez.doctor_first_name @rez.doctor_last_name
                </td>

                <!-- СТАТУС -->
                <td>
                    @rez.status
                </td>

                <!-- ЗАБЕЛЕШКА -->
                <td>
                    @rez.notes
                </td>

                <!-- КРЕИРАНО НА -->
                <td>
                    @(rez.created_on.HasValue
                        ? rez.created_on.Value.ToString("dd.MM.yyyy HH:mm")
                        : "")
                </td>

                <!-- КРЕИРАНО ОД -->
                <td>
                    @rez.created_by
                </td>

                <!-- ИЗМЕНЕТО НА -->
                <td>
                    @(rez.modified_on.HasValue
                        ? rez.modified_on.Value.ToString("dd.MM.yyyy HH:mm")
                        : "")
                </td>

                <!-- ИЗМЕНЕТО ОД -->
                <td>
                    @(rez.modified_by)
                </td>

                <!-- ПРОМЕНИ СТАТУС -->
                <td>
                    @if (rez.status_id == 1)
                    {
                        <button type="button"
                         class="btn btn-sm btn-start"
                         onclick="promeniStatusVoTek(@rez.id)">
                         Започни
                        </button>
                    }
                    else if (rez.status_id == 2)
                    {
                        <button type="button"
                        class="btn btn-sm btn-finish"
                        onclick="promeniStatusVoZavrsen(@rez.id)">
                        Заврши
                        </button>
                    }
                   
                </td>
            <td>
                <button type="button"
                        class="btn btn-info btn-sm"
                        style="white-space: nowrap;"
                        onclick="prikaziIstorija(@rez.patientid, '@rez.patient_first_name @rez.patient_last_name')">
                    Историја<br>на термини
                </button>
            </td>

            </tr>
        }

    </tbody>

</table>