@model List<Status>

@{
    ViewData["Title"] = "Статус";
}

<h1>@ViewData["Title"]</h1>

<script>
    
     function openAddModal() {

            document.getElementById("statusId").value = "";
        document.getElementById("statusName").value = "";

        document.getElementById("statusModalLabel").innerText =
        "Додади статус";

        var modal = new bootstrap.Modal(
        document.getElementById("statusModal")
        );

        modal.show();
    }


        function editStatus(id, statusName) {

            document.getElementById("statusId").value = id;
        document.getElementById("statusName").value = statusName;

        document.getElementById("statusModalLabel").innerText =
        "Измени статус";

        var modal = new bootstrap.Modal(
        document.getElementById("statusModal")
        );

        modal.show();
    }
</script>
<!-- Копче за додавање -->

<div class="text-end mb-3">
    <button type="button"
            class="btn btn-primary"
            onclick="openAddModal()">
        <i class="bi bi-plus-lg"></i> Додади
    </button>
</div>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th scope="col">Ид</th>
            <th scope="col">Име на статус</th>
            <th scope="col">Акции</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var status in Model)
        {
            <tr>
                <td>@status.id</td>
                <td>@status.status_name</td>

                <td>
                    <!-- Измени -->
                    <button type="button"
                            class="btn btn-warning btn-sm"
                            onclick="editStatus(@status.id, '@status.status_name')">
                        <i class="bi bi-pencil"></i>
                    </button>

                    <!-- Избриши -->
                    <form asp-controller="Status" asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@status.id" />

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->

<div class="modal fade"
     id="statusModal"
     tabindex="-1"
     aria-labelledby="statusModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="statusModalLabel">
                    Додади статус
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>


            <form asp-action="Save"
                  method="post">

                <div class="modal-body">

                    <!-- Скриено поле за ID -->
                    <input type="hidden"
                           id="statusId"
                           name="id" />

                    <div class="mb-3">
                        <label class="form-label">
                            Име на статус
                        </label>

                        <input type="text"
                               id="statusName"
                               name="status_name"
                               class="form-control"
                               required />
                    </div>

                </div>


                <div class="modal-footer">

                    <!-- Зачувај -->
                    <button type="submit"
                            class="btn btn-primary">
                        Зачувај
                    </button>

                    <!-- Откажи -->
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Откажи
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

