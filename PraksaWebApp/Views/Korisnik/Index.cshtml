@{
    ViewData["Title"] = "Најава";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="text-center mb-4">Најава</h2>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="Korisnik" asp-action="Index" method="post">


                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text"
                                   name="username"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password"
                                   name="password"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Најави се
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>