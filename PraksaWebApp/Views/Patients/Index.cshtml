@model List<Patient>
@{
    ViewData["Title"] = "Листа од пациенти";
}
<h1>@ViewData["Title"]</h1>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-info">
        <tr>
            <th scope="col">Ид</th> 
            <th scope="col">Име</th>
            <th scope="col">Презиме</th>
            <th scope="col">ЕМБГ</th>
            <th scope="col">Телефон</th>
            <th scope="col">Емаил</th>
        </tr>
        </thead>
<tbody>
    @foreach(var pacient in Model)
        {
            <tr>
                <td>@pacient.id</td>
                <td>@pacient.first_name</td>
                <td>@pacient.last_name</td>
                <td>@pacient.embg</td>
                <td>@pacient.phone</td>
                <td>@pacient.email</td>
            </tr>
        }
    </tbody>
        </table>
 