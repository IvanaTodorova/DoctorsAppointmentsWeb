@model List<Tipovi_na_specijalizacija>
@{
    ViewData["Title"] = "Типови на Специјализација";
}
<h1>@ViewData["Title"]</h1>

<script>
    function DodadiTipNaSpecijalizacija() {
        //alert('Kopceto dodadi e kliknato');
        document.getElementById('novoKopce').style.backgroundColor = 'blue';
        document.getElementById('novoKopce').style.color = 'white';
        document.getElementById('novoKopce').innerText = 'Ново копче';
    };

    function editSpec(id, naziv) {

        document.getElementById("specId").value = id;
        document.getElementById("specNaziv").value = naziv;

        var modal = new bootstrap.Modal(document.getElementById('addModal'));
        modal.show();
    }
</script>

<!-- Button that opens the modal -->
<div class="text-end mb-3">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        Додади
    </button>
</div>


<!-- Bootstrap Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addModalLabel">
                    Додади специјализација
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="Save" method="post">

                <input type="hidden" id="specId" name="Id" />

                <div class="mb-3">
                    <label class="form-label">Назив</label>
                    <input type="text" id="specNaziv" name="naziv" class="form-control" />
                </div>


                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        Зачувај
                    </button>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Откажи
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-info">
        <tr>
            <th>Ид</th>
            <th>Типови на специјализација</th>
            <th>Акции</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var spec in Model)
        {
            <tr>
                <td>@spec.id</td>
                <td>@spec.naziv</td>

                <td>
                    <!-- Edit button -->
                    <button class="btn btn-warning btn-sm"
                            onclick="editSpec(@spec.id, '@spec.naziv')">
                        <i class="bi bi-pencil"></i>
                    </button>

                    <!-- Delete button -->
                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@spec.id" />

                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Дали сте сигурни?')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

