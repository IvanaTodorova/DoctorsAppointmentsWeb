@model AppointmentViewModel

@{
    ViewData["Title"] = "Листа на закажани термини";
}

<style>

    /* Сокриј ги нативните стрелки/календари од прелистувачот за тоа поле */
    input.no-calendar::-webkit-calendar-picker-indicator,
    input.no-calendar::-webkit-inner-spin-button {
        display: none !important;
        -webkit-appearance: none !important;
    }


    table thead th a {
        color: #1f3f55;
        text-decoration: none;
    }

    table thead th a:hover {
        text-decoration: underline;
        cursor: pointer;
    }
</style>
<script>
    function resetAppointmentForm() {

        document.querySelector('input[name="id"]').value = 0;

        const doctor = document.querySelector('[name="doctor_id"]');
        if (doctor && doctor.tagName === "SELECT") {
            doctor.value = "";
        }

        const patient = document.querySelector('[name="patientid"]');
        if (patient && patient.tagName === "SELECT") {
            patient.value = "";
        }

        const dateInput = document.querySelector('input[name="appointmentdate"]');

        dateInput.value = "";

        dateInput.setAttribute(
            "min",
            "@DateTime.Today.ToString("yyyy-MM-dd")"
        );

        dateInput.readOnly = false;
        document.querySelector('input[name="appointmenttime"]').value = "";

        document.querySelector('select[name="status_id"]').value = "";

        document.querySelector('textarea[name="notes"]').value = "";

        document.querySelector(".modal-title").innerText = "Додади термин";
    }

    function editAppointment(id, doctorId, patientId, date, time, statusId, notes) {
        
        document.querySelector('input[name="id"]').value = id;

        document.querySelector('[name="doctor_id"]').value = doctorId;

        document.querySelector('[name="patientid"]').value = patientId;

        const dateInput = document.querySelector('input[name="appointmentdate"]');

        dateInput.value = date;

        // При изменување дозволи да се прикаже и стар датум
        dateInput.removeAttribute("min");

        dateInput.readOnly = false;

        document.querySelector('input[name="appointmenttime"]').value = time;

        const status = document.querySelector('select[name="status_id"]');

        if (status) {
            status.value = String(statusId);
        }

        document.querySelector('textarea[name="notes"]').value = notes || "";

        document.querySelector(".modal-title").innerText = "Измени термин";

        var modal = new bootstrap.Modal(
            document.getElementById("addModal")
        );

        modal.show();
    }
function promeniStatusVoTek(id) {

    const modifiedBy = "@Context.Session.GetString("username")";

    fetch(`/Appointments/PromeniStatusVoTek?id=${id}&modified_by=${encodeURIComponent(modifiedBy)}`, {
        method: "PUT"
    })
    .then(response => {
        return response.text();
    })
    .then(data => {
        const params = new URLSearchParams(window.location.search);

        // Повторно вчитај ја табелата
        fetch('/Appointments/Index?' + params.toString())
            .then(response => response.text())
            .then(html => {

                const parser = new DOMParser();
                const page = parser.parseFromString(html, "text/html");

                const novaTabela = page.querySelector("#appointmentTable");

                if (novaTabela) {
                    document.getElementById("appointmentTable").innerHTML =
                        novaTabela.innerHTML;
                }
            });
    })
    .catch(error => {
        console.error(error);
    });
}

   let terminZaZavrsuvanje = null;

function promeniStatusVoZavrsen(id) {

    terminZaZavrsuvanje = id;

    // Исчисти го полето
    document.getElementById("notesForCompletion").value = "";

    // Отвори Bootstrap modal
    const modal = new bootstrap.Modal(
        document.getElementById("finishAppointmentModal")
    );

    modal.show();
}

function potvrdiZavrsuvanje() {
    const notes =
        document.getElementById("notesForCompletion").value;

    const modifiedBy =
        "@Context.Session.GetString("username")";

    fetch(`/Appointments/PromeniStatusVoZavrsen?id=${terminZaZavrsuvanje}` +
        `&modified_by=${encodeURIComponent(modifiedBy)}` +
        `&notes=${encodeURIComponent(notes)}`, {
            method: "PUT"
        })
        .then(response => {

            if (!response.ok) {
                throw new Error("Грешка при промена на статусот.");
            }
            return response;
        })
        .then((data) => {
            // Затвори го modal-от
            const modalElement =
                document.getElementById("finishAppointmentModal");

            const modal =
                bootstrap.Modal.getInstance(modalElement);

            if (modal) {
                modal.hide();
            }
                // const errorMessage =
                //     document.getElementById("errorMessage");

                // errorMessage.textContent = data.message;
                // errorMessage.style.display = "block";

            // Земи ги моменталните филтри од URL
            const params =
                new URLSearchParams(window.location.search);

            // Повторно вчитај ја табелата
            fetch('/Appointments/Index?' + params.toString())
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const page =
                        parser.parseFromString(html, "text/html");

                    const novaTabela =
                        page.querySelector("#appointmentTable");

                    if (novaTabela) {
                        document.getElementById("appointmentTable").innerHTML =
                            novaTabela.innerHTML;
                    }
                });
        })
        .catch(error => {
            console.error(error);
        });
}
</script>

