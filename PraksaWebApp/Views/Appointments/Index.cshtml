@model AppointmentViewModel

@{
    ViewData["Title"] = "Листа на закажани термини";
}

<style>
    table thead th a {
        color: #1f3f55;
        text-decoration: none;
    }

    table thead th a:hover {
        text-decoration: underline;
        cursor: pointer;
    }
</style>
<script>
     function resetAppointmentForm() {

         document.querySelector('input[name="id"]').value = 0;

         document.querySelector('select[name="doctor_id"]').value = "";

         document.querySelector('select[name="patientid"]').value = "";

         document.querySelector('input[name="appointmentdate"]').value = "";

         document.querySelector('input[name="appointmenttime"]').value = "";

         document.querySelector('select[name="status_id"]').value = "";

         document.querySelector('textarea[name="notes"]').value = "";

         document.querySelector(".modal-title").innerText = "Додади термин";
     }

     function editAppointment(id, doctorId, patientId, date, time, statusId, notes) {

         document.querySelector('input[name="id"]').value = id;

         document.querySelector('select[name="doctor_id"]').value = doctorId;

         document.querySelector('select[name="patientid"]').value = patientId;

         document.querySelector('input[name="appointmentdate"]').value = date;

         document.querySelector('input[name="appointmenttime"]').value = time;

         document.querySelector('select[name="status_id"]').value = statusId;

         document.querySelector('textarea[name="notes"]').value = notes;

         document.querySelector(".modal-title").innerText = "Измени термин";


         var modal = new bootstrap.Modal(
             document.getElementById("addModal")
         );

         modal.show();
    }
    
</script>

    <h1>@ViewData["Title"]</h1>

<div class="text-end mb-3">

    <div class="dropdown d-inline-block">

        <button class="btn btn-primary dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown">
            Филтрирај
        </button>

        <ul class="dropdown-menu">

            <li>
                <h6 class="dropdown-header">
                    Избери:
                </h6>
            </li>

            <li>
                <a class="dropdown-item"
                   href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#dateFilterModal">
                    Датум
                </a>
            </li>

            <li>
                <a class="dropdown-item" href="#">
                    Време
                </a>
            </li>

            <li>
                <a class="dropdown-item" href="#">
                    Пациент
                </a>
            </li>

            <li>
                <a class="dropdown-item" href="#">
                    Лекар
                </a>
            </li>

            <li>
                <a class="dropdown-item" href="#">
                    Статус
                </a>
            </li>

        </ul>

    </div>

    <button class="btn btn-primary"
            onclick="resetAppointmentForm()"
            data-bs-toggle="modal"
            data-bs-target="#addModal">

        Додади

    </button>

</div>

<!-- Прозорче за филтрирање по датум -->
<div class="modal fade" id="dateFilterModal" tabindex="-1">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Избери датум
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Appointments"
                  asp-action="Index"
                  method="get">

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Датум од
                        </label>

                        <input type="text"
                               name="datum_od"
                               class="form-control"
                               value="@ViewBag.DatumOd"
                               id="datumOd" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Датум до
                        </label>

                        <input type="text"
                               name="datum_do"
                               class="form-control"
                               value="@ViewBag.DatumDo"
                               id="datumDo" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Филтрирај

                    </button>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Исчисти
                    </a>

                </div>

            </form>

        </div>

    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<!-- Modal -->
<div class="modal fade" id="addModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Додади термин
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-action="Save" method="post">

                <div class="modal-body">


                    <input type="hidden"
                           name="id"
                           value="0" />


                    <div class="mb-3">

                        <label class="form-label">
                            Доктор
                        </label>


                        <select name="doctor_id"
                                class="form-control"
                                required
                                oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('doctorError').style.display='block' ;"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('doctorError').style.display = 'none';">

                            <option value="">
                                Избери доктор
                            </option>

                            @foreach (var doktor in Model.Doctors)
                            {
                                <option value="@doktor.Id">
                                    @doktor.First_name @doktor.Last_name
                                </option>
                            }

                        </select>

                        <span id="doctorError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Пациент
                        </label>


                        <select name="patientid"
                                class="form-control"
                                required
                                oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('patientError').style.display='block' ;"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('patientError').style.display = 'none';">

                            <option value="">
                                Избери пациент
                            </option>

                            @foreach (var pacient in Model.Patients)
                            {
                                <option value="@pacient.id">
                                    @pacient.first_name @pacient.last_name
                                </option>
                            }

                        </select>

                        <span id="patientError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Датум
                        </label>

                        <input type="date"
                            name="appointmentdate"
                            class="form-control"
                            min="@DateTime.Today.ToString("yyyy-MM-dd")"
                            required
                            oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('dateError').style.display='block';"
                            oninput="this.classList.remove('is-invalid');
                        document.getElementById('dateError').style.display='none';"/>

                        <span id="dateError"
                              class="text-danger"
                              style="display:none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Време
                        </label>

                        <input type="time"
                               name="appointmenttime"
                               class="form-control"
                               required
                               oninvalid="event.preventDefault();
                        this.classList.add('is-invalid');
                        document.getElementById('timeError').style.display='block';"
                               oninput="this.classList.remove('is-invalid');
                        document.getElementById('timeError').style.display='none';" />

                        <span id="timeError"
                              class="text-danger"
                              style="display:none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Статус
                        </label>


                        <select name="status_id"
                                class="form-control"
                                required
                                oninvalid=" event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('statusError').style.display='block';"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('statusError').style.display = 'none';">

                            <option value="">
                                Избери статус
                            </option>

                            @foreach (var status in Model.Status)
                            {
                                <option value="@status.id">
                                    @status.status_name
                                </option>
                            }

                        </select>

                        <span id="statusError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Забелешки
                        </label>

                        <textarea name="notes"
                                  class="form-control"></textarea>

                    </div>


                </div>


                <div class="modal-footer">


                    <button type="submit"
                            class="btn btn-primary">

                        Зачувај

                    </button>


                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Откажи

                    </button>


                </div>


            </form>


        </div>

    </div>
</div>

<partial name="~/Views/Shared/_AppointmentTable.cshtml"
         model="Model.Appointments" />

<nav>
    <ul class="pagination justify-content-center">

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                <a class="page-link"
                   href="@Url.Action("Index", new
                   {
                       page = i,
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo
                   })">
                    @i
                </a>

            </li>
        }
    </ul>
</nav>
@section Scripts {
    <script>
        flatpickr('input[name="datum_od"]', {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            allowInput: true
        });

        flatpickr('input[name="datum_do"]', {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            allowInput: true
        });
    </script>
}