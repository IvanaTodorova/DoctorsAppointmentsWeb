@model AppointmentViewModel

@{
    ViewData["Title"] = "Листа на закажани термини";
}

<style>

    /* Сокриј ги нативните стрелки/календари од прелистувачот за тоа поле */
    input.no-calendar::-webkit-calendar-picker-indicator,
    input.no-calendar::-webkit-inner-spin-button {
        display: none !important;
        -webkit-appearance: none !important;
    }


    table thead th a {
        color: #1f3f55;
        text-decoration: none;
    }

    table thead th a:hover {
        text-decoration: underline;
        cursor: pointer;
    }
</style>
<script>
     function resetAppointmentForm() {

         document.querySelector('input[name="id"]').value = 0;

         document.querySelector('select[name="doctor_id"]').value = "";

         document.querySelector('select[name="patientid"]').value = "";

         document.querySelector('input[name="appointmentdate"]').value = "";

         document.querySelector('input[name="appointmenttime"]').value = "";

         document.querySelector('select[name="status_id"]').value = "";

         document.querySelector('textarea[name="notes"]').value = "";

         document.querySelector(".modal-title").innerText = "Додади термин";
     }

     function editAppointment(id, doctorId, patientId, date, time, statusId, notes) {

         document.querySelector('input[name="id"]').value = id;

         document.querySelector('select[name="doctor_id"]').value = doctorId;

         document.querySelector('select[name="patientid"]').value = patientId;

         document.querySelector('input[name="appointmentdate"]').value = date;

         document.querySelector('input[name="appointmenttime"]').value = time;

         document.querySelector('select[name="status_id"]').value = statusId;

         document.querySelector('textarea[name="notes"]').value = notes;

         document.querySelector(".modal-title").innerText = "Измени термин";


         var modal = new bootstrap.Modal(
             document.getElementById("addModal")
         );

         modal.show();
    }
    
</script>

    <h1>@ViewData["Title"]</h1>

 
<div class="text-end mb-3">

    <div class="dropdown d-inline-block">

        <button class="btn btn-primary dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown">
            Филтрирај
        </button>

        <ul class="dropdown-menu">

            <li>
                <h6 class="dropdown-header">
                    Избери:
                </h6>
            </li>

            <li>
                <a class="dropdown-item"
                   href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#dateFilterModal">
                    Датум
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#timeFilterModal">
                    Време
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#patientFilterModal">
                    Пациент
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#doctorFilterModal">
                    Доктор
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#statusFilterModal">
                    Статус
                </a>
            </li>

        </ul>

    </div>

    @if (!string.IsNullOrEmpty(ViewBag.DatumOd) ||
         !string.IsNullOrEmpty(ViewBag.DatumDo) ||
         !string.IsNullOrEmpty(ViewBag.VremeOd) ||
         !string.IsNullOrEmpty(ViewBag.VremeDo) ||
         !string.IsNullOrEmpty(ViewBag.Patient) ||
         !string.IsNullOrEmpty(ViewBag.Doctor) ||
         !string.IsNullOrEmpty(ViewBag.StatusFilter))
    {
        <a asp-controller="Appointments"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm ms-1"
           title="Исчисти филтер">

            ×
        </a>
    }

    <button class="btn btn-primary"
            onclick="resetAppointmentForm()"
            data-bs-toggle="modal"
            data-bs-target="#addModal">

        Додади

    </button>

</div>

<!-- Прозорче за филтрирање по датум -->
<div class="modal fade" id="dateFilterModal" tabindex="-1">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Избери датум
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Appointments"
                  asp-action="Index"
                  method="get">

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Датум од
                        </label>

                        <input type="text"
                               name="datum_od"
                               class="form-control"
                               value="@ViewBag.DatumOd"
                               id="datumOd" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Датум до
                        </label>

                        <input type="text"
                               name="datum_do"
                               class="form-control"
                               value="@ViewBag.DatumDo"
                               id="datumDo" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Филтрирај

                    </button>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Исчисти
                    </a>

                </div>

            </form>

        </div>

    </div>
</div>

<!-- Прозорче за филтрирање по време -->
<div class="modal fade" id="timeFilterModal" tabindex="-1">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Избери време
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Appointments"
                  asp-action="Index"
                  method="get">

                <input type="hidden"
                       name="datum_od"
                       value="@ViewBag.DatumOd" />

                <input type="hidden"
                       name="datum_do"
                       value="@ViewBag.DatumDo" />

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Време од
                        </label>

                        <input type="time"
                               name="vreme_od"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Време до
                        </label>

                        <input type="time"
                               name="vreme_do"
                               class="form-control" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Филтрирај
                    </button>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Исчисти
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Прозорче за филтрирање по пациент -->
<div class="modal fade" id="patientFilterModal" tabindex="-1">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Избери пациент
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Appointments"
                  asp-action="Index"
                  method="get">

                <input type="hidden"
                       name="datum_od"
                       value="@ViewBag.DatumOd" />

                <input type="hidden"
                       name="datum_do"
                       value="@ViewBag.DatumDo" />

                <input type="hidden"
                       name="vreme_od"
                       value="@ViewBag.VremeOd" />

                <input type="hidden"
                       name="vreme_do"
                       value="@ViewBag.VremeDo" />

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Име на пациент
                        </label>

                        <input type="search"
                               name="patient"
                               class="form-control no-calendar"
                               autocomplete="off"
                               value="@Context.Request.Query["patient"]" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Филтрирај
                    </button>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Исчисти
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Прозорче за филтрирање по доктор-->
<div class="modal fade" id="doctorFilterModal" tabindex="-1">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Избери доктор
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Appointments"
                  asp-action="Index"
                  method="get">

                <input type="hidden"
                       name="datum_od"
                       value="@ViewBag.DatumOd" />

                <input type="hidden"
                       name="datum_do"
                       value="@ViewBag.DatumDo" />

                <input type="hidden"
                       name="vreme_od"
                       value="@ViewBag.VremeOd" />

                <input type="hidden"
                       name="vreme_do"
                       value="@ViewBag.VremeDo" />

                <input type="hidden"
                       name="patient"
                       value="@ViewBag.Patient" />

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Име на доктор
                        </label>

                        <input type="search"
                               name="doctor"
                               class="form-control"
                               autocomplete="off"
                               value="@ViewBag.Doctor" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Филтрирај
                    </button>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Исчисти
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Прозорче за филтрирање по статус -->
<div class="modal fade" id="statusFilterModal" tabindex="-1">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Избери статус
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Appointments"
                  asp-action="Index"
                  method="get">

                <input type="hidden"
                       name="datum_od"
                       value="@ViewBag.DatumOd" />

                <input type="hidden"
                       name="datum_do"
                       value="@ViewBag.DatumDo" />

                <input type="hidden"
                       name="vreme_od"
                       value="@ViewBag.VremeOd" />

                <input type="hidden"
                       name="vreme_do"
                       value="@ViewBag.VremeDo" />

                <input type="hidden"
                       name="patient"
                       value="@ViewBag.Patient" />

                <input type="hidden"
                       name="doctor"
                       value="@ViewBag.Doctor" />

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Статус
                        </label>

                        <select name="status"
                                class="form-control">

                            <option value="">
                                Избери статус
                            </option>

                            <option value="ЗАКАЖАН"
                                    selected="@(ViewBag.StatusFilter == "ЗАКАЖАН")">
                                ЗАКАЖАН
                            </option>

                            <option value="ВО ТЕК"
                                    selected="@(ViewBag.StatusFilter == "ВО ТЕК")">
                                ВО ТЕК
                            </option>

                            <option value="ЗАВРШЕН"
                                    selected="@(ViewBag.StatusFilter == "ЗАВРШЕН")">
                                ЗАВРШЕН
                            </option>

                            <option value="ОТКАЖАН"
                                    selected="@(ViewBag.StatusFilter == "ОТКАЖАН")">
                                ОТКАЖАН
                            </option>

                        </select>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Филтрирај
                    </button>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Исчисти
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<!-- Modal -->
<div class="modal fade" id="addModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Додади термин
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-action="Save" method="post">

                <div class="modal-body">


                    <input type="hidden"
                           name="id"
                           value="0" />


                    <div class="mb-3">

                        <label class="form-label">
                            Доктор
                        </label>


                        <select name="doctor_id"
                                class="form-control"
                                required
                                oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('doctorError').style.display='block' ;"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('doctorError').style.display = 'none';">

                            <option value="">
                                Избери доктор
                            </option>

                            @foreach (var doktor in Model.Doctors)
                            {
                                <option value="@doktor.Id">
                                    @doktor.First_name @doktor.Last_name
                                </option>
                            }

                        </select>

                        <span id="doctorError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Пациент
                        </label>


                        <select name="patientid"
                                class="form-control"
                                required
                                oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('patientError').style.display='block' ;"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('patientError').style.display = 'none';">

                            <option value="">
                                Избери пациент
                            </option>

                            @foreach (var pacient in Model.Patients)
                            {
                                <option value="@pacient.id">
                                    @pacient.first_name @pacient.last_name
                                </option>
                            }

                        </select>

                        <span id="patientError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Датум
                        </label>

                        <input type="date"
                            name="appointmentdate"
                            class="form-control"
                            min="@DateTime.Today.ToString("yyyy-MM-dd")"
                            required
                            oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('dateError').style.display='block';"
                            oninput="this.classList.remove('is-invalid');
                        document.getElementById('dateError').style.display='none';"/>

                        <span id="dateError"
                              class="text-danger"
                              style="display:none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Време
                        </label>

                        <input type="time"
                               name="appointmenttime"
                               class="form-control"
                               required
                               oninvalid="event.preventDefault();
                        this.classList.add('is-invalid');
                        document.getElementById('timeError').style.display='block';"
                               oninput="this.classList.remove('is-invalid');
                        document.getElementById('timeError').style.display='none';" />

                        <span id="timeError"
                              class="text-danger"
                              style="display:none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Статус
                        </label>


                        <select name="status_id"
                                class="form-control"
                                required
                                oninvalid=" event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('statusError').style.display='block';"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('statusError').style.display = 'none';">

                            <option value="">
                                Избери статус
                            </option>

                            @foreach (var status in Model.Status)
                            {
                                <option value="@status.id">
                                    @status.status_name
                                </option>
                            }

                        </select>

                        <span id="statusError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Забелешки
                        </label>

                        <textarea name="notes"
                                  class="form-control"></textarea>

                    </div>


                </div>


                <div class="modal-footer">


                    <button type="submit"
                            class="btn btn-primary">

                        Зачувај

                    </button>


                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Откажи

                    </button>


                </div>

            </form>

        </div>

    </div>
</div>

<div class="d-flex justify-content-center mb-4">
    <div class="border rounded-3 shadow-sm px-4 py-2"
         style="width: 70%; background-color: #f8f9fa;">

        <div class="d-flex justify-content-around text-center">

            <div>
                <div class="fw-bold fs-5 text-primary counter"
                     data-target="@ViewBag.TotalAppointments">
                    0
                </div>
                <small class="text-muted">
                    Вкупно
                </small>
            </div>

            <div>
                <div class="fw-bold fs-5 text-warning counter"
                     data-target="@ViewBag.ScheduledAppointments">
                    0
                </div>
                <small class="text-muted">
                    Закажани
                </small>
            </div>

            <div>
                <div class="fw-bold fs-5 text-success counter"
                     data-target="@ViewBag.CompletedAppointments">
                    0
                </div>
                <small class="text-muted">
                    Завршени
                </small>
            </div>

            <div>
                <div class="fw-bold fs-5 text-danger counter"
                     data-target="@ViewBag.CancelledAppointments">
                    0
                </div>
                <small class="text-muted">
                    Откажани
                </small>
            </div>

        </div>

    </div>
</div>

<partial name="~/Views/Shared/_AppointmentTable.cshtml"
         model="Model.Appointments" />

<nav>
    <ul class="pagination justify-content-center">

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                <a class="page-link"
                   href="@Url.Action("Index", new
                   {
                       page = i,
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo,
                       vreme_od = ViewBag.VremeOd,
                       vreme_do = ViewBag.VremeDo,
                       patient = ViewBag.Patient,
                       doctor = ViewBag.Doctor,
                       status = ViewBag.StatusFilter,
                       sort = ViewBag.Sort
                   })">
                    @i
                </a>

            </li>
        }
    </ul>
</nav>
@section Scripts {
    <script>
        flatpickr('#datumOd', {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            allowInput: true
        });

        flatpickr('#datumDo', {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            allowInput: true
        });


        document.querySelectorAll('.counter').forEach(counter => {

            const target = Number(counter.getAttribute('data-target'));
            let current = 0;

            const duration = 800;
            const increment = target / (duration / 20);

            const updateCounter = () => {

                current += increment;

                if (current >= target) {
                    counter.textContent = target;
                    return;
                }

                counter.textContent = Math.floor(current);

                setTimeout(updateCounter, 20);
            };

            updateCounter();
        });
    </script>
}