</div>

<div id="appointmentTable">
    <partial name="~/Views/Shared/_AppointmentTable.cshtml"
             model="Model.Appointments" />
</div>

<nav>
    <ul class="pagination justify-content-center">

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                <a class="page-link"
                   href="@Url.Action("Index", new
                   {
                       page = i,
                       datum_od = ViewBag.DatumOd,
                       datum_do = ViewBag.DatumDo,
                       vreme_od = ViewBag.VremeOd,
                       vreme_do = ViewBag.VremeDo,
                       patient = ViewBag.Patient,
                       doctor = ViewBag.Doctor,
                       status = ViewBag.StatusFilter,
                       sort = ViewBag.Sort
                   })">
                    @i
                </a>

            </li>
        }
    </ul>
</nav>

<!-- Modal за завршување на термин -->
<div class="modal fade"
     id="finishAppointmentModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Заврши преглед
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label for="notesForCompletion"
                           class="form-label">
                        Забелешка
                    </label>

                    <textarea id="notesForCompletion"
                              class="form-control"
                              rows="4"
                              placeholder="Внесете забелешка (опционално)..."></textarea>

                    <small class="text-muted">
                        Полето не е задолжително.
                    </small>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Откажи
                </button>

                <button type="button"
                        class="btn btn-success"
                        onclick="potvrdiZavrsuvanje()">
                    Заврши
                </button>

            </div>

        </div>

    </div>

</div>


<!-- Modal за историја на термини -->
<div class="modal fade"
     id="historyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Историја на термини -
                    <span id="historyPatientName"></span>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="historyLoading"
                     class="text-center">
                    Вчитување...
                </div>

                <div class="table-responsive">

                    <table class="table table-bordered table-hover"
                           id="historyTable"
                           style="display:none;">

                        <thead class="table-info">

                            <tr>
                                <th>Датум</th>
                                <th>Време</th>
                                <th>Доктор</th>
                                <th>Статус</th>
                                <th>Забелешка</th>
                            </tr>

                        </thead>

                        <tbody id="historyTableBody">
                        </tbody>

                    </table>

                </div>

                <div id="noHistory"
                     class="alert alert-info"
                     style="display:none;">
                    Овој пациент нема претходни термини.
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Затвори
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        flatpickr('#datumOd', {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            allowInput: true
        });

        flatpickr('#datumDo', {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            allowInput: true
        });


        function startCounters() {

            document.querySelectorAll('.counter').forEach(counter => {

                const target = Number(counter.getAttribute('data-target'));
                let current = 0;

                const duration = 800;
                const increment = target / (duration / 20);

                const updateCounter = () => {

                    current += increment;

                    if (current >= target) {
                        counter.textContent = target;
                        return;
                    }

                    counter.textContent = Math.floor(current);

                    setTimeout(updateCounter, 20);
                };

                updateCounter();
            });
    }

    document.getElementById("appointmentForm").addEventListener("submit", function (e) {

        e.preventDefault();

        const form = this;
        const formData = new FormData(form);

        fetch('/Appointments/Save', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {

            if (data.success) {

                // Затвори го modal-от
                const modalElement = document.getElementById("addModal");
                const modal = bootstrap.Modal.getInstance(modalElement);

                if (modal) {
                    modal.hide();
                }

                // Земи ги моменталните филтри од URL
                const params = new URLSearchParams(window.location.search);

                // Повторно земи ја Index страницата
                fetch('/Appointments/Index?' + params.toString())
                    .then(response => response.text())
                    .then(html => {

                        const parser = new DOMParser();
                        const page = parser.parseFromString(html, "text/html");

                        // =========================
                        // UPDATE STATISTICS
                        // =========================

                        const newStatistics =
                            page.querySelector("#appointmentStatistics");

                        if (newStatistics) {

                            document.getElementById("appointmentStatistics").innerHTML =
                                newStatistics.innerHTML;

                            startCounters();
                        }

                        // =========================
                        // UPDATE TABLE
                        // =========================

                        const newTable =
                            page.querySelector("#appointmentTable");

                        if (newTable) {

                            document.getElementById("appointmentTable").innerHTML =
                                newTable.innerHTML;
                        }

                        // =========================
                        // RESTART COUNTERS
                        // =========================

                        document.querySelectorAll(".counter").forEach(counter => {

                            const target =
                                parseInt(counter.getAttribute("data-target"));

                            counter.textContent = target;
                        });
                        const errorMessage =
                        document.getElementById("errorMessage");

                        // errorMessage.textContent = data.message;
                        // errorMessage.style.background-color = "green";
                        errorMessage.style.display = "none";

                    });
            }
            else {

                const modalElement = document.getElementById("addModal");
                const modal = bootstrap.Modal.getInstance(modalElement);

                if (modal) {
                    modal.hide();
                }

                const errorMessage =
                    document.getElementById("errorMessage");

                errorMessage.textContent = data.message;
                errorMessage.style.display = "block";
            }
        })
        .catch(error => {
            console.error("Error:", error);
        });
    });

    startCounters();

function formatDate(date) {
    if (!date) return "";

    const d = new Date(date);

    const day = String(d.getDate()).padStart(2, "0");
    const month = String(d.getMonth() + 1).padStart(2, "0");
    const year = d.getFullYear();

    return `${day}.${month}.${year}`;
}

function formatTime(time) {
    if (!time) return "";

    return time.substring(0, 5);
}

function prikaziIstorija(patientId, patientName) {

    document.getElementById("historyPatientName").textContent =
        patientName;

    const tbody =
        document.getElementById("historyTableBody");

    tbody.innerHTML = "";

    document.getElementById("historyLoading").style.display =
        "block";

    document.getElementById("historyTable").style.display =
        "none";

    document.getElementById("noHistory").style.display =
        "none";

    const modal = new bootstrap.Modal(
        document.getElementById("historyModal")
    );

    modal.show();

    fetch(`/Appointments/GetPatientHistory?patientId=${patientId}`)
        .then(response => {

            if (!response.ok) {
                throw new Error("Грешка при вчитување на историјата.");
            }

            return response.json();
        })
        .then(termini => {

            document.getElementById("historyLoading").style.display =
                "none";

            if (termini.length === 0) {

                document.getElementById("noHistory").style.display =
                    "block";

                return;
            }

            termini.forEach(termin => {

                const row = document.createElement("tr");

                row.innerHTML = `
                    <td>
                        ${formatDate(termin.appointmentdate)}
                    </td>

                    <td>
                        ${formatTime(termin.appointmenttime)}
                    </td>

                    <td>
                        ${termin.doctor_first_name ?? ""}
                        ${termin.doctor_last_name ?? ""}
                    </td>

                    <td>
                        ${termin.status ?? ""}
                    </td>

                    <td>
                        ${termin.notes ?? ""}
                    </td>
                `;

                tbody.appendChild(row);
            });

            document.getElementById("historyTable").style.display =
                "table";
        })
        .catch(error => {

            console.error(error);

            document.getElementById("historyLoading").textContent =
                "Настана грешка при вчитување на историјата.";
        });
}
    </script>
}