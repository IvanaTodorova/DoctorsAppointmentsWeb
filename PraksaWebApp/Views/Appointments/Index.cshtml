<!-- Modal -->
<div class="modal fade" id="addModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Додади термин
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-action="Save" method="post" id="appointmentForm">

                <div class="modal-body">

                    <input type="hidden"
                           name="id"
                           value="0" />

                    <div class="mb-3">

                        <label class="form-label">
                            Доктор
                        </label>

                        @if (Context.Session.GetInt32("tip_na_korisnik") == 1)
                        {
                            var doktor = Model.Doctors.FirstOrDefault();

                            <input type="hidden"
                                   name="doctor_id"
                                   value="@doktor?.Id" />

                            <input type="text"
                                   class="form-control"
                                   value="@doktor?.First_name @doktor?.Last_name"
                                   readonly />
                        }
                        else
                        {
                            <select name="doctor_id"
                                    class="form-control"
                                    required
                                    oninvalid="event.preventDefault();
                                this.classList.add('is-invalid');
                                document.getElementById('doctorError').style.display='block';"
                                    onchange="this.classList.remove('is-invalid');
                                document.getElementById('doctorError').style.display='none';">

                                <option value="">
                                    Избери доктор
                                </option>

                                @foreach (var doktor in Model.Doctors)
                                {
                                    <option value="@doktor.Id">
                                        @doktor.First_name @doktor.Last_name
                                    </option>
                                }

                            </select>
                        }

                        <span id="doctorError"
                              class="text-danger"
                              style="display: none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Пациент
                        </label>

                        @if (Context.Session.GetInt32("tip_na_korisnik") == 2)
                        {
                            var pacient = Model.Patients.FirstOrDefault();

                            <input type="hidden"
                                   name="patientid"
                                   value="@pacient?.id" />

                            <input type="text"
                                   class="form-control"
                                   value="@pacient?.first_name @pacient?.last_name"
                                   readonly />
                        }
                        else
                        {
                            <select name="patientid"
                                    class="form-control"
                                    required
                                    oninvalid="event.preventDefault();
                                this.classList.add('is-invalid');
                                document.getElementById('patientError').style.display='block';"
                                    onchange="this.classList.remove('is-invalid');
                                document.getElementById('patientError').style.display='none';">

                                <option value="">
                                    Избери пациент
                                </option>

                                @foreach (var pacient in Model.Patients)
                                {
                                    <option value="@pacient.id">
                                        @pacient.first_name @pacient.last_name
                                    </option>
                                }

                            </select>
                        }

                        <span id="patientError"
                              class="text-danger"
                              style="display: none;">
                            Полето е задолжително
                        </span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Датум
                        </label>

                        <input type="date"
                            name="appointmentdate"
                            class="form-control"
                            min="@DateTime.Today.ToString("yyyy-MM-dd")"
                            required
                            oninvalid="event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('dateError').style.display='block';"
                            oninput="this.classList.remove('is-invalid');
                        document.getElementById('dateError').style.display='none';"/>

                        <span id="dateError"
                              class="text-danger"
                              style="display:none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Време
                        </label>

                        <input type="time"
                               name="appointmenttime"
                               class="form-control"
                               required
                               oninvalid="event.preventDefault();
                        this.classList.add('is-invalid');
                        document.getElementById('timeError').style.display='block';"
                               oninput="this.classList.remove('is-invalid');
                        document.getElementById('timeError').style.display='none';" />

                        <span id="timeError"
                              class="text-danger"
                              style="display:none;">
                            Полето е задолжително
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Статус
                        </label>


                        <select name="status_id"
                                class="form-control"
                                required
                                oninvalid=" event.preventDefault();
                            this.classList.add('is-invalid');
                            document.getElementById('statusError').style.display='block';"
                                onchange="this.classList.remove('is-invalid');
                            document.getElementById('statusError').style.display = 'none';">

                            <option value="">
                                Избери статус
                            </option>

                            @foreach (var status in Model.Status)
                            {
                                <option value="@status.id">
                                    @status.status_name
                                </option>
                            }

                        </select>

                        <span id="statusError"
                              class="text-danger"
                              style="display: none;">

                            Полето е задолжително

                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Забелешки
                        </label>

                        <textarea name="notes"
                                  class="form-control"></textarea>

                    </div>


                </div>


                <div class="modal-footer">


                    <button type="submit"
                            class="btn btn-primary">

                        Зачувај

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Откажи

                    </button>

                </div>

            </form>

        </div>

    </div>
</div>

